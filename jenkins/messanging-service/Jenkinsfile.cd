// ═══════════════════════════════════════════════════════════════
// CD — messaging-service
// Déclenché automatiquement par CI après succès
// ═══════════════════════════════════════════════════════════════
pipeline {
    agent any

    parameters {
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Tag de l\'image Docker à déployer')
    }

    environment {
        IMAGE_NAME   = 'nesrineromdhani/messanging-service'
        K8S_MANIFEST = 'k8s/messaging-deployment.yaml'
        SERVICE_PORT = '8085'
    }

    stages {

        stage('1 — Docker Login') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKER_USER',
                    passwordVariable: 'DOCKER_PASS'
                )]) {
                    sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                    echo '✅ Connecté à Docker Hub'
                }
            }
        }

        stage('2 — Docker Push') {
            steps {
                sh "docker push ${IMAGE_NAME}:${params.IMAGE_TAG}"
                sh "docker push ${IMAGE_NAME}:latest"
                echo "✅ Image ${IMAGE_NAME}:${params.IMAGE_TAG} poussée sur Docker Hub"
            }
        }

        stage('3 — Mise à jour manifest Kubernetes') {
            steps {
                sh """
                    sed -i 's|image: ${IMAGE_NAME}:.*|image: ${IMAGE_NAME}:${params.IMAGE_TAG}|g' ${K8S_MANIFEST}
                    echo '✅ Manifest mis à jour avec tag ${params.IMAGE_TAG}'
                    cat ${K8S_MANIFEST} | grep image:
                """
            }
        }

        stage('4 — Git push manifest') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'github-credentials',
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_PASS'
                )]) {
                    sh """
                        git config user.email "jenkins@certifypro.com"
                        git config user.name "Jenkins CD"
                        git checkout -B feature/clean-job-module
                        git add ${K8S_MANIFEST}
                        git commit -m "cd(messaging): deploy image tag ${params.IMAGE_TAG}" || echo 'Rien à committer'
                        git push https://\${GIT_USER}:\${GIT_PASS}@github.com/sirineee22/Esprit-PiProject-4SAE8-2026-CertifyPro.git feature/clean-job-module:feature/clean-job-module
                    """
                }
                echo '✅ Manifest poussé — Argo CD va détecter le changement'
            }
        }

        stage('5 — Attendre Argo CD') {
            steps {
                echo '⏳ Attente du déploiement Argo CD (60s)...'
                sleep(60)
                echo '✅ Argo CD a eu le temps de synchroniser'
            }
        }

        stage('6 — Vérification santé /actuator/health') {
            steps {
                sh """
                    curl -f http://localhost:${SERVICE_PORT}/actuator/health \\
                      && echo '✅ Service UP et healthy' \\
                      || echo '⚠️ Service pas encore disponible'
                """
            }
        }

        stage('7 — Prometheus actif') {
            steps {
                sh """
                    curl -f http://localhost:${SERVICE_PORT}/actuator/prometheus \\
                      && echo '✅ Métriques Prometheus exposées' \\
                      || echo '⚠️ Prometheus endpoint non disponible'
                """
            }
        }
    }

    post {
        success { echo "🎉 CD messaging-service déployé — tag: ${params.IMAGE_TAG}" }
        failure { echo '❌ CD messaging-service échoué' }
        always  { sh 'docker logout || true' }
    }
}
