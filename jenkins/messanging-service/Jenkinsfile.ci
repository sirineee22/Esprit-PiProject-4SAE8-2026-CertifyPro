// ═══════════════════════════════════════════════════════════════
// CI — messaging-service
// ═══════════════════════════════════════════════════════════════
pipeline {
    agent any

    environment {
        SERVICE_DIR = 'backend/services/messanging-service'
        IMAGE_NAME  = 'nesrineromdhani/messanging-service'
        COMMIT_SHA  = "${env.GIT_COMMIT?.take(7) ?: 'latest'}"
        JWT_SECRET  = 'test-secret-min-32-chars-for-testing-only'
    }

    stages {

        stage('1 — Checkout') {
            steps {
                checkout scm
                echo "✅ Code récupéré — commit: ${env.GIT_COMMIT?.take(7) ?: 'N/A'}"
            }
        }

        stage('2 — chmod +x mvnw') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh 'chmod +x mvnw'
                }
            }
        }

        stage('3 — Tests unitaires + JaCoCo') {
            steps {
                dir("${SERVICE_DIR}") {
                    withEnv([
                        "JWT_SECRET=${env.JWT_SECRET}",
                        'SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/test_db'
                    ]) {
                        sh './mvnw test jacoco:report --no-transfer-progress -q'
                    }
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: "${SERVICE_DIR}/target/surefire-reports/*.xml"
                }
            }
        }

        stage('4 — SonarQube') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    dir("${SERVICE_DIR}") {
                        withSonarQubeEnv('SonarQube') {
                            sh """
                                ./mvnw sonar:sonar \
                                  -Dsonar.projectKey=messanging-service \
                                  -Dsonar.projectName="Messaging Service" \
                                  -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml \
                                  --no-transfer-progress -q
                            """
                        }
                    }
                }
            }
        }

        stage('5 — Build JAR') {
            steps {
                dir("${SERVICE_DIR}") {
                    sh './mvnw package -DskipTests --no-transfer-progress -q'
                    echo '✅ JAR créé dans target/'
                }
            }
        }

        stage('6 — Docker Build') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    dir("${SERVICE_DIR}") {
                        sh "docker build -t ${IMAGE_NAME}:${COMMIT_SHA} -t ${IMAGE_NAME}:latest . --quiet"
                        echo "✅ Image ${IMAGE_NAME}:${COMMIT_SHA} créée"
                    }
                }
            }
        }

        stage('7 — Prometheus Check') {
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                    sh """
                        docker run -d --name test-msg-${BUILD_NUMBER} \
                          -e JWT_SECRET=${JWT_SECRET} \
                          -e SPRING_DATA_MONGODB_URI=mongodb://host.docker.internal:27017/test_db \
                          -p 18085:8085 ${IMAGE_NAME}:${COMMIT_SHA} || true
                        sleep 25
                        curl -f http://localhost:18085/actuator/prometheus \
                          && echo '✅ /actuator/prometheus OK' \
                          || echo '⚠️ endpoint non disponible'
                        docker stop test-msg-${BUILD_NUMBER} && docker rm test-msg-${BUILD_NUMBER} || true
                    """
                }
            }
        }
    }

    post {
        success {
            echo "🎉 CI messaging-service réussi !"
            build job: 'messanging-service-CD',
                  wait: false,
                  parameters: [string(name: 'IMAGE_TAG', value: "${COMMIT_SHA}")]
        }
        failure {
            echo '❌ CI messaging-service échoué — vérifier les logs'
        }
        always {
            archiveArtifacts artifacts: "${SERVICE_DIR}/target/*.jar",
                             allowEmptyArchive: true
        }
    }
}
