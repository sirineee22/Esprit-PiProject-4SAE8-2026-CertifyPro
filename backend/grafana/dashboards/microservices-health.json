        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 8,
      "options": {
        "legend": {
          "calcs": [
            "mean"
          ],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "pluginVersion": "8.0.0",
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])",
          "intervalFactor": 1,
          "legendFormat": "{{ job }} - 5xx errors",
          "refId": "A"
        }
      ],
      "title": "Error Rate by Service",
      "type": "timeseries"
